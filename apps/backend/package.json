{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env scripts/test.ts",
    "test:unit": "vitest run tests/api-response.test.ts",
    "test:e2e": "tsx --env-file-if-exists=.env scripts/test.ts --e2e",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "seed:auth": "tsx --env-file-if-exists=.env prisma/seed-auth.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.2",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@faker-js/faker": "9.9.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "openapi-types": "12.1.3",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
