# Postgres from root docker-compose.yml (host port 5434)
DATABASE_URL="postgresql://postgres:password123@localhost:5434/azatech_order_db?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3200"
API_PUBLIC_URL="http://localhost:4000/api"
NODE_ENV="development"
# `pnpm env:setup` generates independent random secrets; never use these placeholders.
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-random-secret-at-least-32-characters"
# `pnpm env:setup` fills these locally and generates a random password.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional: TEST_DATABASE_URL (must use a separate database ending in _test)
