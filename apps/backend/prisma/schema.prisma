// Azatech Order Management — database schema.
// Column/table names follow the spec (snake_case) via @map/@@map; TS stays camelCase.
// CHECK constraints (price > 0, stock >= 0, quantity > 0) are not expressible in Prisma;
// they live in prisma/migrations/*_check_constraints/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Pria
  Wanita

  @@map("gender")
}

model User {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255) // bcrypt hash
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Extra table (not in spec): lets /auth/logout revoke refresh tokens server-side.
model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64) // sha256 hex, never store raw token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id          BigInt    @id @default(autoincrement())
  // ponytail: plain unique => code of a soft-deleted product cannot be reused.
  // Upgrade: partial unique index WHERE deleted_at IS NULL.
  productCode String    @unique @map("product_code") @db.VarChar(20)
  productName String    @map("product_name") @db.VarChar(150)
  stock       Int       @default(0)
  price       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@map("products")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  customerName    String    @map("customer_name") @db.VarChar(150)
  customerAddress String    @map("customer_address") @db.VarChar(255)
  gender          Gender
  birthDate       DateTime  @map("birth_date") @db.Date
  phone           String?   @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

model Order {
  id          BigInt   @id @default(autoincrement())
  orderNumber String   @unique @map("order_number") @db.VarChar(30)
  customerId  String   @map("customer_id") @db.Uuid
  createdBy   BigInt   @map("created_by")
  orderDate   DateTime @default(now()) @map("order_date") @db.Timestamptz(3)
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict: history must survive; customers/products are soft-deleted instead.
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator  User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@index([orderDate]) // date-range filter + dashboard
  @@index([customerId, orderDate]) // customer filter
  @@index([createdBy])
  @@map("orders")
}

model OrderItem {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @map("order_id")
  productId BigInt   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2) // price snapshot at order time
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId]) // top-selling aggregation
  @@map("order_items")
}
