# Docker Compose: run pnpm env:setup to generate random secrets in the ignored .env.
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-random-secret-at-least-32-characters"
# Optional overrides (all default to the URLs/ports below).
# FRONTEND_PORT=3200
# BACKEND_PORT=4000
# FRONTEND_URL=http://localhost:3200
# PUBLIC_API_URL=http://localhost:4000/api
# `pnpm env:setup` copies seed credentials from apps/backend/.env for Compose.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
