{"nodes": [{"id": "readme_aza_commerce", "label": "Aza Commerce Order Management", "file_type": "document", "source_file": "README.md", "source_location": "lines 1-8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_backend", "label": "Express 5 backend service", "file_type": "concept", "source_file": "README.md", "source_location": "lines 13, 26-27, 138-144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit routing and centralized native async error handling; all business logic and database access remain in the backend."}, {"id": "readme_frontend", "label": "React 19 and Next.js 16 App Router frontend", "file_type": "concept", "source_file": "README.md", "source_location": "lines 18, 26-27, 145-149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page routing and layout composition in a separately runnable service; browser calls the Express REST API."}, {"id": "readme_postgresql", "label": "PostgreSQL 16", "file_type": "concept", "source_file": "README.md", "source_location": "line 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraints, transactions, row locks and advisory locks protect stock and order-number integrity."}, {"id": "readme_prisma", "label": "Prisma 6.19.3", "file_type": "concept", "source_file": "README.md", "source_location": "line 15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type-safe queries, controlled migrations, Decimal money arithmetic and continuity with the existing foundation."}, {"id": "readme_authentication", "label": "JWT access and rotating refresh sessions", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 16, 116-118, 177-178, 353-354", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-lived access tokens and revocable rotated refresh tokens; SHA256 refresh hashes and session checks make logout immediately effective. Cross-tab refresh synchronization is not implemented."}, {"id": "readme_zod", "label": "Zod strict boundary validation", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 17, 157-158", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One body/query/parameter validation boundary maps indexed field errors to UI and rejects client-supplied authoritative order fields."}, {"id": "readme_tanstack_query", "label": "TanStack Query server state", "file_type": "concept", "source_file": "README.md", "source_location": "line 19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caching, request status, mutation invalidation and refetch avoid repeated manual fetch state."}, {"id": "readme_pnpm_workspaces", "label": "pnpm 10 workspaces", "file_type": "concept", "source_file": "README.md", "source_location": "lines 21, 35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Central dependencies and commands while keeping backend and frontend independently runnable; setup pins pnpm 10.33.0."}, {"id": "readme_testing", "label": "Vitest, Supertest and Playwright verification", "file_type": "concept", "source_file": "README.md", "source_location": "lines 22, 190-232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real PostgreSQL integration tests verify transactions without mocks; separate test and E2E databases isolate data, and production browser runs verify desktop/mobile user flows."}, {"id": "readme_openapi", "label": "OpenAPI 3.0.3 and Swagger UI Express", "file_type": "concept", "source_file": "README.md", "source_location": "lines 24, 234-266", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive request/response contracts, authentication and business examples; source contract is apps/backend/src/docs/openapi.ts and validation uses Swagger Parser."}, {"id": "readme_environment_setup", "label": "pnpm env:setup", "file_type": "concept", "source_file": "README.md", "source_location": "lines 48-49, 79-84, 105-108, 313-315", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generate missing local configuration, random JWT secrets and seed-admin password while retaining existing values; credentials remain in Git-ignored environment files."}, {"id": "readme_database_bootstrap", "label": "pnpm db:bootstrap and idempotent seed", "file_type": "concept", "source_file": "README.md", "source_location": "lines 50-54, 77-96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wait for database health, generate Prisma Client, migrate and seed without resetting data; seed provides one admin, 20 products, 15 customers and up to 30 demo orders. Separate db:seed:auth creates only an admin."}, {"id": "readme_atomic_order", "label": "Atomic multi-item order transaction", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 155-172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validate 1-100 distinct products, lock active masters, snapshot prices, allocate a number, save items and decrement stock in one transaction. Commit precedes 201; any failure rolls back; only transient conflicts retry up to three attempts."}, {"id": "readme_row_locking", "label": "Customer FOR SHARE and ordered product FOR UPDATE locks", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 160-162, 170-172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer shared lock prevents concurrent soft deletion; product locks in ID order reduce deadlocks and prevent overselling. Stock and prices are read after locking."}, {"id": "readme_decimal_snapshot", "label": "Prisma.Decimal historical price snapshot", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 163, 179, 184-185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact decimal unit prices and totals preserve historical transaction prices; money is serialized as two-decimal strings, while names follow current master data."}, {"id": "readme_order_number", "label": "INV-YYYYMMDD-XXXX daily order numbering", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 164-165, 352", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transaction-scoped advisory lock per Jakarta date serializes allocation; a unique constraint remains a backstop. More than 9999 orders per day is rejected with 409."}, {"id": "readme_soft_delete_history", "label": "Soft-delete historical master relationships", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 123-127, 180-185, 341-348", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No cascading deletion from customers/products preserves history; archived product codes remain reserved, historical prices are snapshots, and historical names follow current masters."}, {"id": "readme_jakarta_time", "label": "Asia/Jakarta business calendar", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 164, 186-187, 270-272, 347-348", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timezone-aware storage and inclusive Indonesian date filters mapped to a half-open interval keep numbering, history and daily sales aligned with the business calendar."}, {"id": "readme_daily_sales", "label": "Daily sales dashboard and Recharts", "file_type": "concept", "source_file": "README.md", "source_location": "lines 29, 128-130, 270-275", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-filled daily series, 7/30/90-day controls, responsive SVG and keyboard access complement a complete daily table; headline cards remain all-time."}, {"id": "readme_export", "label": "Filtered CSV and ExcelJS history export", "file_type": "concept", "source_file": "README.md", "source_location": "lines 30-31, 276-284, 358-359", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export every matching order across pages using historical price snapshots; CSV neutralizes formulas and Excel separates order/item sheets. Current in-memory generation motivates future streaming or background jobs."}, {"id": "readme_idempotency_key", "label": "Planned order idempotency key", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 355-357, 363", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not implemented; prioritized to prevent duplicate orders when clients retry after losing a response."}, {"id": "readme_ai_usage", "label": "OpenCode and Context7 usage disclosure", "file_type": "concept", "source_file": "README.md", "source_location": "lines 372-378", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenCode supported analysis, planning, implementation, tests and documentation; Context7 supplied library references, with candidate responsibility for understanding and maintaining the result."}], "edges": [{"source": "_github_workflows_ci_quality_checks", "target": "readme_testing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "lines 331-335", "weight": 1.0}, {"source": "readme_aza_commerce", "target": "readme_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "lines 8-18", 