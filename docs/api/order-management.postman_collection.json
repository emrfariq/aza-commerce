{
  "info": {
    "name": "Aza Commerce — Order Management API",
    "description": "Track A REST API. Set email/password variables locally from apps/backend/.env, then run folders in order against seeded local data. Credentials are intentionally blank in this public collection. Login/refresh store access_token; refresh uses Postman's cookie jar. CRUD examples create their own product/customer, then soft-delete them after an order. History remains intact. Monetary values are decimal strings; dates use Asia/Jakarta business boundaries. See docs/api/README.md for full contracts and errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000/api" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "product_id", "value": "1" },
    { "key": "product_code", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "order_id", "value": "1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Successful HTTP status', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));",
          "if (pm.response.code !== 204) pm.test('Consistent success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "200: data.access_token, expires_in (900 seconds), user. Refresh JWT is set as an HttpOnly cookie valid for 7 days. Invalid credentials: 401; invalid body: 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('access_token', pm.response.json().data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rotate refresh token",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/auth/refresh",
            "description": "Authenticates via refresh_token cookie, rotates its hash/JWT, returns new access token and user. No access token required. Missing/expired/revoked/reused cookie: 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('access_token', pm.response.json().data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "description": "Returns only id, name, email. Requires active Bearer session."
          }
        },
        {
          "name": "Authenticated health",
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        }
      ]
    },
    {
      "name": "02 Products",
      "item": [
        {
          "name": "List, search, paginate and sort",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products?page=1&per_page=10&search=&sort=-price",
            "description": "sort: product_name, -product_name, price, -price, stock, -stock. search matches name/code case-insensitively. page>=1; per_page 1..100. Response includes pagination meta."
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('product_code', 'PM' + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('product_id', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"product_code\":\"{{product_code}}\",\"product_name\":\"Produk Postman\",\"stock\":10,\"price\":\"12000.50\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "201. Unique code<=20, name<=150, stock integer>=0, price>0 with max two decimals. Duplicate code (including archived code):409. Validation:422."
          }
        },
        {
          "name": "Product detail",
          "request": { "method": "GET", "url": "{{base_url}}/products/{{product_id}}" }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/products/{{product_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"product_code\":\"{{product_code}}\",\"product_name\":\"Produk Postman Updated\",\"stock\":10,\"price\":\"15000.25\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Full replacement of editable fields. Updating stock is an explicit administrative stock adjustment. 200; archived/missing product:404."
          }
        }
      ]
    },
    {
      "name": "03 Customers",
      "item": [
        {
          "name": "List and search customers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers?page=1&per_page=10&search=",
            "description": "Case-insensitive customer name search, alphabetical sort, pagination meta."
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/customers",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_name\":\"Pelanggan Postman\",\"customer_address\":\"Jakarta\",\"gender\":\"Pria\",\"birth_date\":\"1995-02-10\",\"phone\":\"081234567890\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "201. name<=150, address<=255, gender Pria/Wanita, valid birth_date YYYY-MM-DD not in future, optional nullable phone<=20. UUID generated by server."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('customer_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer detail",
          "request": { "method": "GET", "url": "{{base_url}}/customers/{{customer_id}}" }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/customers/{{customer_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_name\":\"Pelanggan Postman Updated\",\"customer_address\":\"Bandung\",\"gender\":\"Pria\",\"birth_date\":\"1995-02-10\",\"phone\":null}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "04 Orders",
      "item": [
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_id\":\"{{customer_id}}\",\"items\":[{\"product_id\":{{product_id}},\"quantity\":2}]}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "201: full order with customer, creator and items.product. 1..100 distinct products; positive integer quantities. Only customer_id/items allowed; price/total fields rejected. Server snapshots prices, calculates totals, locks stock and allocates INV-YYYYMMDD-XXXX atomically. 422 on invalid/deleted customer/product or insufficient stock with errors.items.N.quantity. All writes rollback on failure."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('order_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Order detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}",
            "description": "Snapshot unit_price/subtotal/total never change with catalog price. Archived products/customers still included. 404 if order absent."
          }
        },
        {
          "name": "Order history",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders?page=1&per_page=10&customer_id={{customer_id}}",
            "description": "Optional from=YYYY-MM-DD and to=YYYY-MM-DD inclusive in Asia/Jakarta; from>to:422. Optional customer_id UUID. Latest first, then id descending. meta pagination; rows include customer and _count.items."
          }
        }
      ]
    },
    {
      "name": "05 Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard/summary",
            "description": "data: total_transactions number, total_sales decimal string, top_products[{product,quantity_sold}] max5 by quantity descending (archived included), low_stock_products[] active stock<5 incl0. All-time summary from a consistent DB snapshot."
          }
        }
      ]
    },
    {
      "name": "06 Cleanup and logout",
      "item": [
        {
          "name": "Soft delete product",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/products/{{product_id}}",
            "description": "204 without body. Leaves order history intact. Existing code remains reserved."
          }
        },
        {
          "name": "Soft delete customer",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/customers/{{customer_id}}",
            "description": "204 without body. Leaves order history intact."
          }
        },
        {
          "name": "Historical detail after deletion",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}" }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "description": "Revokes current session, clears cookie; access token immediately rejected. Other login sessions remain active."
          }
        }
      ]
    }
  ]
}
